# ---------------------------------------------------------------------------
# AEGIS AERIAL INTELLIGENCE — environment configuration
# Copy to .env and adjust. NEVER commit a real .env. All variables are optional
# unless marked REQUIRED FOR PRODUCTION.
# ---------------------------------------------------------------------------

# development | production | test
AEGIS_ENV=development

# Local-first storage root (database, encrypted media, frames, reports, keys).
AEGIS_DATA_DIR=./data

# Database. Default: SQLite inside AEGIS_DATA_DIR. For larger deployments:
# AEGIS_DATABASE_URL=postgresql+psycopg://aegis:CHANGE_ME@db:5432/aegis
AEGIS_DATABASE_URL=

# Encryption at rest (Fernet key, 32-byte urlsafe base64). REQUIRED FOR PRODUCTION.
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is generated once and stored in $AEGIS_DATA_DIR/.keys/fernet.key (0600).
# Losing the key makes encrypted media/notes unreadable — back it up securely.
AEGIS_ENCRYPTION_KEY=
AEGIS_ENCRYPT_AT_REST=true

# Bootstrap administrator (created only when no users exist). REQUIRED FOR PRODUCTION.
# If the password is unset, a random one is written to $AEGIS_DATA_DIR/.keys/bootstrap_admin_password.txt
AEGIS_BOOTSTRAP_ADMIN_USER=admin
AEGIS_BOOTSTRAP_ADMIN_PASSWORD=

# Sessions
AEGIS_SESSION_TTL_MINUTES=480
AEGIS_SESSION_IDLE_MINUTES=60
AEGIS_MAX_FAILED_LOGINS=5
AEGIS_LOCKOUT_MINUTES=15
# Set true when served over HTTPS (reverse proxy / TLS terminator)
AEGIS_COOKIE_SECURE=false

# CORS allow-list for the dev server (production serves UI and API from one origin)
AEGIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo mode (ENTER DEMO MODE on the login screen). Disable in production.
AEGIS_DEMO_MODE_ENABLED=true

# Upload limit (MB)
AEGIS_MAX_UPLOAD_MB=512

# AI providers
# auto | yolo_onnx | classical
AEGIS_DETECTOR_PROVIDER=auto
# Path to a LOCAL YOLOv5/v8 ONNX model (nothing is downloaded automatically)
AEGIS_YOLO_MODEL_PATH=
AEGIS_TRACKER_PROVIDER=sort_lite
AEGIS_MAX_PROCESS_WIDTH=960

# Live feed: RTSP adapter (legitimate camera sources only; admin opt-in)
AEGIS_RTSP_ENABLED=false

# Online basemap tiles reveal the area of interest to a third-party tile server.
# Keep false for offline / sensitive work (local tactical grid + imagery mosaics are used).
AEGIS_ONLINE_TILES_ENABLED=false

# Only for the optional "postgres" compose profile
POSTGRES_PASSWORD=
